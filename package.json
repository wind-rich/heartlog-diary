{
  "name": "heartlog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "心意簿 — 记录伴侣的日常、偏好与回忆（本地优先 PWA）",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "tsc -b && vite build",
    "build:viewer": "node scripts/gen-icons.mjs && node scripts/build-viewer-site.mjs",
    "build:real": "node scripts/gen-icons.mjs && node scripts/build-site.mjs",
    "build:site": "node scripts/gen-icons.mjs && node scripts/build-site.mjs",
    "snapshot:public": "node scripts/build-public-snapshot.mjs",
    "verify:snapshot": "node verify/verify-real-snapshot.mjs",
    "verify:author": "node verify/verify-author.mjs",
    "verify:sync": "node verify/verify-sync.mjs",
    "verify:tasks": "node verify/verify-tasks.mjs",
    "verify:v4": "node verify/verify-v4-migration.mjs",
    "verify:cloud-publish": "node verify/verify-cloud-publish.mjs",
    "verify:viewer-build": "node verify/verify-viewer-build.mjs",
    "preview": "vite preview --host",
    "proxy": "node server/proxy.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "node verify/verify-e2e.mjs",
    "verify:cloud": "node verify/verify-cloud.mjs",
    "typecheck": "tsc --noEmit",
    "verify:bundle": "node verify/verify-bundle.mjs",
    "verify:game": "node verify/verify-game.mjs"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "^0.1.3-dev.c090db7.202610050023",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "lunar-javascript": "^1.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
